rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Solution project uploads
    match /solutions/{userId}/{fileName} {
      // Any authenticated user can download/read solutions
      allow read: if request.auth != null;
      // Only the author can create an upload, max 10MB
      allow create: if request.auth != null 
                    && request.auth.uid == userId
                    && request.resource.size < 10 * 1024 * 1024;
      // Only the author can delete their uploaded files
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Default post images and avatar uploads
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
